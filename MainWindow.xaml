<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Apple Player" Width="1120" Height="760" MinWidth="900" MinHeight="640" WindowStartupLocation="CenterScreen" Background="#FAFAFC" FontFamily="Segoe UI" Foreground="#202027" AllowDrop="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#FA3559"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#565661"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.7"/><Setter TargetName="Shell" Property="Background" Value="#EAEAF0"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="12,9"/><Setter Property="Background" Value="#EEEEF3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><Grid><TextBlock x:Name="Hint" Text="Поиск музыки" Foreground="#9999A5" IsHitTestVisible="False" Visibility="Collapsed"/><ScrollViewer x:Name="PART_ContentHost"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Slider"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Height="22" Background="Transparent"><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="#FA3559" Height="4" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="12" Height="12"><Thumb.Template><ControlTemplate><Ellipse Fill="White" Stroke="#D3D3DE" StrokeThickness="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="#E5E5ED" Height="4" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" CornerRadius="9" Background="Transparent" Padding="12,10"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F1F1F6"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#FDE7ED"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="112"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
  <Border Background="#F0F0F5" BorderBrush="#E5E5EB" BorderThickness="0,0,1,0">
   <DockPanel Margin="22,28,18,20">
    <StackPanel DockPanel.Dock="Top"><TextBlock Text="♫" Foreground="{StaticResource Accent}" FontSize="38"/><TextBlock Text="Apple Player" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,36"/><TextBlock Text="МЕДИАТЕКА" FontSize="10" Foreground="#93939E" FontWeight="Bold" Margin="10,0,0,12"/>
     <Button x:Name="LibraryButton" Content="♫    Все треки" HorizontalContentAlignment="Left" Background="#E3E3EB" Foreground="#202027" Margin="0,0,0,5"/>
     <Button x:Name="FavoritesButton" Content="♡    Избранное" Margin="0,0,0,28"/>
     <TextBlock Text="ДОБАВИТЬ МУЗЫКУ" FontSize="10" Foreground="#93939E" FontWeight="Bold" Margin="10,0,0,12"/>
     <Button x:Name="AddButton" Content="＋    Выбрать файлы"/><Button x:Name="FolderButton" Content="▱    Выбрать папку"/>
    </StackPanel>
    <StackPanel VerticalAlignment="Bottom"><TextBlock Text="Ваша музыка.&#x0a;Ваш ритм." Foreground="#93939E" FontSize="16" LineHeight="24"/><TextBlock Text="Локально · Без рекламы" Foreground="#A2A2AC" FontSize="10" Margin="0,12,0,0"/></StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="30,30,24,12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><TextBlock x:Name="PageTitle" Text="Вся музыка" FontSize="32" FontWeight="Bold"/><Button x:Name="MoreAddButton" Content="＋" Background="{StaticResource Accent}" Foreground="White" FontSize="19" HorizontalAlignment="Right" Padding="12,5" ToolTip="Добавить файлы (Ctrl+O)"/></Grid>
   <TextBlock x:Name="CountLabel" Grid.Row="1" Text="Соберите свою коллекцию" Foreground="#9595A0" Margin="1,8,0,22"/>
   <TextBox x:Name="Search" Grid.Row="2" ToolTip="Поиск по названию, исполнителю и альбому" Margin="0,0,0,18" AutomationProperties.Name="Поиск музыки"><TextBox.ContextMenu><ContextMenu>
    <MenuItem Header="Вырезать" Command="ApplicationCommands.Cut" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
    <MenuItem Header="Копировать" Command="ApplicationCommands.Copy" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
    <MenuItem Header="Вставить" Command="ApplicationCommands.Paste" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
    <Separator/><MenuItem Header="Выделить всё" Command="ApplicationCommands.SelectAll" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
   </ContextMenu></TextBox.ContextMenu></TextBox>
   <Grid Grid.Row="3">
    <ListBox x:Name="Tracks" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
     <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="♫" Foreground="#FA3559" FontSize="21" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="#90909B" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Heart}" Foreground="#FA3559" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate>
     <ListBox.ContextMenu><ContextMenu><MenuItem x:Name="PlayMenu" Header="Воспроизвести"/><MenuItem x:Name="FavoriteMenu" Header="В избранное / убрать"/><Separator/><MenuItem x:Name="RemoveMenu" Header="Убрать из медиатеки"/></ContextMenu></ListBox.ContextMenu>
    </ListBox>
    <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="♫" Foreground="#D3D3DF" FontSize="72" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyTitle" Text="Здесь будет ваша музыка" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,8"/><TextBlock x:Name="EmptyHint" Text="Перетащите MP3 сюда или добавьте файлы" FontSize="12" Foreground="#9595A0" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel>
   </Grid>
   <TextBlock x:Name="Status" Grid.Row="4" Text="Двойной щелчок по треку — воспроизведение" Foreground="#90909B" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
  </Grid>
  <Border Grid.Column="2" Background="#F4F4F8" BorderBrush="#E8E8EE" BorderThickness="1,0,0,0">
   <StackPanel Margin="24,34,24,0"><TextBlock Text="СЕЙЧАС ИГРАЕТ" Foreground="#9696A1" FontSize="10" FontWeight="Bold" Margin="0,0,0,30"/>
    <Border CornerRadius="20" Height="230"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF8FAD"/><GradientStop Color="#F7406B" Offset="0.5"/><GradientStop Color="#AB65D8" Offset="1"/></LinearGradientBrush></Border.Background><Grid><Grid.Clip><RectangleGeometry Rect="0,0,230,230" RadiusX="20" RadiusY="20"/></Grid.Clip><TextBlock x:Name="CoverNote" Text="♫" FontSize="106" Foreground="#EEFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="Cover" Stretch="UniformToFill"/></Grid></Border>
    <TextBlock x:Name="NowTitle" Text="Поймайте настроение" FontWeight="Bold" FontSize="21" TextWrapping="Wrap" MaxHeight="64" Margin="0,24,0,7"/>
    <TextBlock x:Name="NowArtist" Text="Выберите любимый трек" Foreground="#90909C" FontSize="14" TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="NowAlbum" Foreground="#A3A3AD" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,5,0,18"/>
    <Button x:Name="HeartButton" Content="♡   В избранное" Foreground="{StaticResource Accent}" Background="#FCE4EB" ToolTip="Избранное"/>
    <TextBlock Text="Хорошая музыка всегда рядом." Foreground="#A2A2AE" FontSize="11" TextAlignment="Center" Margin="0,28,0,0"/>
   </StackPanel>
  </Border>
  <Border Grid.Row="1" Grid.ColumnSpan="3" Background="White" BorderBrush="#E6E6EE" BorderThickness="0,1,0,0">
   <Grid Margin="24,12"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><TextBlock x:Name="MiniTitle" Text="Музыка начинается здесь" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="MiniArtist" Text="Добавьте первый трек" Foreground="#9898A2" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
    <Grid Grid.Column="1" Margin="16,0"><Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="ShuffleButton" Content="⤨" FontSize="23" ToolTip="Случайный порядок"/><Button x:Name="PreviousButton" Content="⏮" FontSize="22" ToolTip="Предыдущий (Ctrl+←)"/><Button x:Name="PlayButton" Content="▶" FontSize="20" Width="50" Height="46" Background="#FA3559" Foreground="White" ToolTip="Воспроизведение / пауза (Пробел)"/><Button x:Name="NextButton" Content="⏭" FontSize="22" ToolTip="Следующий (Ctrl+→)"/><Button x:Name="RepeatButton" Content="↻" FontSize="24" ToolTip="Повтор: выключен / все / один"/></StackPanel><Grid Grid.Row="1" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><TextBlock x:Name="Elapsed" Text="0:00" FontSize="10" Foreground="#9B9BA5" VerticalAlignment="Center"/><Slider x:Name="Seek" Grid.Column="1" Minimum="0" Maximum="1" VerticalAlignment="Center" IsMoveToPointEnabled="True" AutomationProperties.Name="Позиция воспроизведения"/><TextBlock x:Name="Duration" Grid.Column="2" Text="0:00" FontSize="10" Foreground="#9B9BA5" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Grid>
    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="MuteButton" Content="♪" FontSize="19" ToolTip="Выключить звук"/><Slider x:Name="Volume" Width="125" Minimum="0" Maximum="1" Value="0.7" IsMoveToPointEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="Громкость"/></StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
